<Window x:Class="Folderite.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folderite Settings"
        Width="960" Height="640" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <!-- Content extends into the title bar (like Windows Settings); DWM still draws the caption buttons.
         The Title above is kept for the taskbar and for App.OpenSettings, which finds this window by it. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" UseAeroCaptionButtons="True"
                      ResizeBorderThickness="6" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Title bar strip: not hit-test visible in chrome, so it drags the window -->
        <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="18"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="Folderite" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </StackPanel>

        <!-- Navigation -->
        <DockPanel Grid.Row="1" Margin="8,4,4,12">
            <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent"
                     SelectionChanged="Nav_SelectionChanged">
                <!-- Windows 11 navigation look: subtle fill on hover/selection plus a short accent bar. -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bg" CornerRadius="4" Background="Transparent" Padding="8,3">
                                        <Grid>
                                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" Margin="-8,0,0,0"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Hidden"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <ContentPresenter />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" />
                            <TextBlock Text="{Binding Title}" Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Page -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="12,0,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,16">
                <Button x:Name="PreviewButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                        Style="{StaticResource ToolButton}" Margin="0" Content="&#xE890;" Tag="Preview menu"
                        ToolTip="Show the folder menu as it looks with these settings"
                        Click="Preview_Click" />
                <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitle}" />
            </DockPanel>

            <!-- config.json could not be read: autosave is off until it's fixed -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12"
                    Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                    Visibility="{Binding LoadError, Converter={StaticResource NotNullToVisible}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Open file" Margin="0,0,8,0" Click="OpenConfigFile_Click" />
                        <Button Content="Reload" Command="{Binding ReloadCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEA39;" Margin="0,0,12,0"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold"
                                   Text="config.json has an error, so changes here are not saved." />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding LoadError}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Row="2" Focusable="False" />

            <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Margin="2,10,0,0" Text="{Binding Status}" />
        </Grid>
    </Grid>
</Window>
