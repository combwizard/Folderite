<UserControl x:Class="Folderite.Settings.Pages.FavoritesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Folderite.Settings.ViewModels">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="2*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <!-- Tree -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="8">
                    <Button Style="{StaticResource ToolButton}" Content="&#xE8F4;" Tag="Add folder"
                            ToolTip="Add one or more folders" Click="AddFolder_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE8F1;" ToolTip="Add a group (submenu)"
                            Command="{Binding Favorites.AddGroupCommand}" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE738;" ToolTip="Add a separator"
                            Command="{Binding Favorites.AddSeparatorCommand}" />
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE70E;" ToolTip="Move up"
                            Command="{Binding Favorites.MoveUpCommand}" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE70D;" ToolTip="Move down"
                            Command="{Binding Favorites.MoveDownCommand}" />
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE74D;" ToolTip="Remove (Del)"
                            Command="{Binding Favorites.RemoveSelectedCommand}" />
                </WrapPanel>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="14,8,14,10"
                           Text="Drag to reorder, or onto a group to move it inside. Drop folders from Explorer to add them." />

                <Grid>
                    <TreeView x:Name="Tree" ItemsSource="{Binding Favorites.Roots}" AllowDrop="True"
                              BorderThickness="0" Background="Transparent" Padding="4"
                              SelectedItemChanged="Tree_SelectedItemChanged"
                              PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="Tree_PreviewMouseMove"
                              DragEnter="Tree_DragOver" DragOver="Tree_DragOver"
                              DragLeave="Tree_DragLeave" Drop="Tree_Drop"
                              KeyDown="Tree_KeyDown">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:FavoriteNodeVm}" ItemsSource="{Binding Children}">
                                <Grid MinHeight="28">
                                    <!-- Folder / group -->
                                    <StackPanel x:Name="Row" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid Width="16" Height="16" Margin="0,0,10,0">
                                            <Image x:Name="FolderIcon" Source="{Binding Path, Converter={StaticResource PathToIcon}}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock x:Name="GroupIcon" Style="{StaticResource Glyph}" Text="&#xE8F1;"
                                                       Visibility="Collapsed" HorizontalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="Key" Style="{StaticResource Caption}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" Text="{Binding Accelerator}" ToolTip="Shortcut key"
                                                   Visibility="{Binding Accelerator, Converter={StaticResource NotNullToVisible}}" />
                                        <TextBlock x:Name="PathText" Style="{StaticResource Caption}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="320" />
                                        <TextBlock x:Name="Missing" Style="{StaticResource Glyph}" FontSize="13" Text="&#xE7BA;"
                                                   Margin="8,0,0,0" ToolTip="This folder doesn't exist"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                   Visibility="{Binding PathMissing, Converter={StaticResource BoolToVisible}}" />
                                    </StackPanel>
                                    <!-- Separator -->
                                    <Rectangle x:Name="Line" Height="1" Width="180" HorizontalAlignment="Left" Margin="2,0,0,0"
                                               VerticalAlignment="Center" Visibility="Collapsed"
                                               Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                                </Grid>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:FavoriteKind.Group}">
                                        <Setter TargetName="FolderIcon" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="GroupIcon" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="PathText" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:FavoriteKind.Separator}">
                                        <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding Favorites.Roots.Count, Converter={StaticResource ZeroToVisible}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE734;" FontSize="32" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextAlignment="Center"
                                   Text="No favorites yet. Add a folder, or drop one here." />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Details -->
        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <Grid>
                <TextBlock Style="{StaticResource Caption}" Text="Select a favorite to edit it."
                           Visibility="{Binding Favorites.Selected, Converter={StaticResource NullToVisible}}" />

                <StackPanel DataContext="{Binding Favorites.Selected}"
                            Visibility="{Binding Converter={StaticResource NotNullToVisible}}">
                    <TextBlock x:Name="KindTitle" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" Text="Folder" />

                    <StackPanel x:Name="NameFields">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0">
                            <Run Text="Put &amp; before a letter to make it the shortcut key, &amp;&amp; for a plain &amp;." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Visibility="{Binding Accelerator, Converter={StaticResource NotNullToVisible}}">
                            <Run Text="Shortcut key:" /> <Run Text="{Binding Accelerator, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel x:Name="PathFields">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Folder" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="6,0,0,0"
                                    Content="&#xE838;" ToolTip="Browse" Click="Browse_Click" />
                            <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="Environment variables such as %USERPROFILE% are allowed." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding PathMissing, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE7BA;"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="6,0,0,0" Text="This folder doesn't exist." />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="SeparatorNote" Style="{StaticResource Caption}" Visibility="Collapsed"
                               Text="A line between menu items. Nothing to set." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
