<UserControl x:Class="Folderite.Settings.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Remove only makes sense with a row selected. -->
        <Style x:Key="RemoveButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Style="{StaticResource ToolButton}" Content="&#xE72C;" Tag="Refresh"
                        ToolTip="Reload the list" Command="{Binding RefreshCommand}" />
                <Button Style="{StaticResource RemoveButton}" Content="&#xE74D;" Tag="Remove"
                        ToolTip="Remove the selected folder from history" Command="{Binding RemoveCommand}" />
                <Button Style="{StaticResource ToolButton}" Margin="0" Content="&#xE894;" Tag="Clear all"
                        ToolTip="Forget every folder" Click="ClearAll_Click" />
            </StackPanel>
            <Grid>
                <TextBox x:Name="SearchBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Orientation="Horizontal" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Filter, Converter={StaticResource NullToVisible}}">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE721;"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Search folders" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- List -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="14,8,14,10">
                    <Run Text="{Binding Rows.Count, Mode=OneWay}" /> of <Run Text="{Binding TotalCount, Mode=OneWay}" /> folders. Ranked by how often and how recently you visit them.
                </TextBlock>
                <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                <Grid>
                    <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" Padding="4"
                             HorizontalContentAlignment="Stretch"
                             MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="4,2" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="28" Margin="4,0" ToolTip="{Binding Path}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Source="{Binding Path, Converter={StaticResource PathToIcon}}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding Parent}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="320" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Margin="16,0,4,0"
                                               VerticalAlignment="Center" TextAlignment="Right" TextWrapping="NoWrap"
                                               Text="{Binding LastUsedText, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVisible}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" FontSize="32" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Margin="0,10,0,0" TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Text" Value="No folders match your search." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TotalCount}" Value="0">
                                            <Setter Property="Text" Value="No history yet. Folders you open will show up here." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
