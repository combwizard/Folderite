<UserControl x:Class="Folderite.Settings.Pages.ExclusionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0">

            <!-- Folders never added to history -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,4" Text="Don't remember these folders" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Matching folders are never added to Recent or History. Wildcards: * matches any text, ? matches one character. For example C:\Windows\* or *\node_modules\*." />

                    <ItemsControl x:Name="ExcludeList" ItemsSource="{Binding HistoryExclude}" Margin="0,10,0,0"
                                  Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="6,0,0,0"
                                            Content="&#xE74D;" ToolTip="Remove this pattern"
                                            Command="{Binding DataContext.RemoveExcludeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="No patterns yet."
                               Visibility="{Binding HistoryExclude.Count, Converter={StaticResource ZeroToVisible}}" />

                    <Button Style="{StaticResource ToolButton}" Margin="0,6,0,0" HorizontalAlignment="Left"
                            Content="&#xE710;" Tag="Add pattern" Command="{Binding AddExcludeCommand}"
                            Click="AddExclude_Click" />
                </StackPanel>
            </Border>

            <!-- Apps where the menu stays out of the way -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,4" Text="Don't open the menu in these apps" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Folderite ignores its trigger while one of these programs is in front. Use the program name without .exe." />

                    <ItemsControl ItemsSource="{Binding DisabledProcesses}" Margin="0,10,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4"
                                        Margin="0,0,6,6" Padding="10,2,2,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Value}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Button Style="{StaticResource ToolButton}" Margin="6,0,0,0" Padding="6,4"
                                                MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                                                Content="&#xE711;" ToolTip="Remove"
                                                Command="{Binding DataContext.RemoveDisabledProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="No apps yet."
                               Visibility="{Binding DisabledProcesses.Count, Converter={StaticResource ZeroToVisible}}" />

                    <DockPanel Margin="0,10,0,0">
                        <Button x:Name="AddAppButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="12,0,0,0"
                                Content="&#xE8FD;" Tag="Add app..." ToolTip="Pick from the apps that are running now"
                                Click="AddApp_Click" />
                        <Button DockPanel.Dock="Right" Content="Add" Margin="6,0,0,0" Click="AddTyped_Click" />
                        <TextBox x:Name="ProcessBox" KeyDown="ProcessBox_KeyDown" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Type a program name such as notepad, or pick from the running apps." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
