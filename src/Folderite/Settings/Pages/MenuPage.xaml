<UserControl x:Class="Folderite.Settings.Pages.MenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:Folderite.Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0">
            <TextBlock Style="{StaticResource SectionTitle}" Margin="2,0,0,8" Text="Sections" />

            <ContentControl Style="{StaticResource SettingRow}" s:Setting.Icon="&#xE81C;" s:Setting.Title="Recent folders"
                            s:Setting.Description="How many recently used folders to list in the Recent submenu.">
                <StackPanel Orientation="Horizontal" Width="240">
                    <Slider x:Name="RecentSlider" Width="190" Minimum="0" Maximum="50"
                            IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="5"
                            VerticalAlignment="Center"
                            Value="{Binding RecentCount, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource Body}" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding RecentCount}" />
                </StackPanel>
            </ContentControl>

            <ContentControl Style="{StaticResource SettingRow}" s:Setting.Icon="&#xE81C;" s:Setting.Title="Show recent folders for this app"
                            s:Setting.Description="Add a second submenu with the folders you use most in the app the menu is opened over.">
                <CheckBox MinWidth="0" IsChecked="{Binding ShowAppRecent}" />
            </ContentControl>

            <ContentControl Style="{StaticResource SettingRow}" s:Setting.Icon="&#xE8A7;" s:Setting.Title="Show open windows"
                            s:Setting.Description="List the folders that are open in Explorer windows right now.">
                <CheckBox MinWidth="0" IsChecked="{Binding ShowOpenWindows}" />
            </ContentControl>

            <ContentControl Style="{StaticResource SettingRow}" s:Setting.Icon="&#xE77F;" s:Setting.Title="Show clipboard folder"
                            s:Setting.Description="Offer the folder you last copied, when the clipboard holds a folder path.">
                <CheckBox MinWidth="0" IsChecked="{Binding ShowClipboard}" />
            </ContentControl>

            <ContentControl Style="{StaticResource SettingRow}" s:Setting.Icon="&#xEDA2;" s:Setting.Title="Show drives"
                            s:Setting.Description="Add a Drives submenu with the free space on each drive.">
                <CheckBox MinWidth="0" IsChecked="{Binding ShowDrives}" />
            </ContentControl>

            <ContentControl Style="{StaticResource SettingRow}" s:Setting.Icon="&#xE7F4;" s:Setting.Title="Work on the desktop"
                            s:Setting.Description="Also show the menu on the desktop. Choosing a folder there opens it in a new Explorer window.">
                <CheckBox MinWidth="0" IsChecked="{Binding EnableOnDesktop}" />
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
