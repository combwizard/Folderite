<UserControl x:Class="Folderite.Settings.Pages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:Folderite.Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0">

            <ContentControl Style="{StaticResource SettingRow}" s:Setting.Icon="&#xE7E8;" s:Setting.Title="Start with Windows"
                            s:Setting.Description="Run Folderite in the background whenever you sign in.">
                <CheckBox MinWidth="0" IsChecked="{Binding StartWithWindows}" />
            </ContentControl>

            <ContentControl s:Setting.Icon="&#xE769;" s:Setting.Title="Pause Folderite">
                <ContentControl.Style>
                    <Style TargetType="ContentControl" BasedOn="{StaticResource SettingRow}">
                        <Setter Property="s:Setting.Description" Value="Stop the menu from appearing until you turn this off." />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTrayRunning}" Value="False">
                                <Setter Property="s:Setting.Description" Value="Folderite isn't running." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <Grid>
                    <CheckBox MinWidth="0" IsChecked="{Binding IsPaused}"
                              Visibility="{Binding IsTrayRunning, Converter={StaticResource BoolToVisible}}" />
                    <Button Content="Start Folderite" Command="{Binding StartFolderiteCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTrayRunning}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </ContentControl>

            <ContentControl Style="{StaticResource SettingRow}" s:Setting.Icon="&#xE765;" s:Setting.Title="Keyboard shortcut"
                            s:Setting.Description="Opens the folder menu for the window in front. Leave empty to use only the middle mouse button.">
                <StackPanel HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Looks like a text box but only records: keys are read in PreviewKeyDown. -->
                        <Grid Width="180">
                            <TextBox x:Name="HotkeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False" IsUndoEnabled="False"
                                     Text="{Binding Hotkey, Mode=OneWay}" ContextMenu="{x:Null}"
                                     AutomationProperties.Name="Keyboard shortcut"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     GotKeyboardFocus="HotkeyBox_FocusChanged" LostKeyboardFocus="HotkeyBox_FocusChanged" />
                            <TextBlock Text="None" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasHotkey}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Content="Clear" Margin="8,0,0,0" Command="{Binding ClearHotkeyCommand}"
                                IsEnabled="{Binding HasHotkey}" />
                    </StackPanel>
                    <TextBlock x:Name="HotkeyCaption" Style="{StaticResource Caption}" MaxWidth="260" Margin="0,6,0,0"
                               HorizontalAlignment="Right" TextAlignment="Right" Visibility="Collapsed" />
                </StackPanel>
            </ContentControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Configuration" />

            <!-- Like a SettingRow, but the path needs a selectable box under the title. -->
            <Border Style="{StaticResource Card}" Padding="16,12" MinHeight="64" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Glyph}" FontSize="20" Margin="0,0,16,0" Text="&#xE8A5;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Body}" Text="Config file" />
                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="9"
                                    Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Settings are stored next to Folderite.exe"
                                    Visibility="{Binding IsPortable, Converter={StaticResource BoolToVisible}}">
                                <TextBlock FontSize="11" Text="Portable"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBox Text="{Binding ConfigPath, Mode=OneWay}" IsReadOnly="True" FontSize="12"
                                 TextWrapping="Wrap" Margin="0,2,0,0" Padding="0" HorizontalContentAlignment="Left"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="{Binding LocationCaption}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Change location…" Click="ChangeLocation_Click"
                                    IsEnabled="{Binding CanChangeLocation}" />
                            <Button Content="Use default" Margin="8,0,0,0" Click="UseDefault_Click"
                                    IsEnabled="{Binding CanChangeLocation}"
                                    Visibility="{Binding CanUseDefault, Converter={StaticResource BoolToVisible}}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{Binding PortableNote}"
                                   Visibility="{Binding IsPortable, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Open file" Command="{Binding OpenConfigFileCommand}" />
                        <Button Content="Open folder" Margin="8,0,0,0" Command="{Binding OpenConfigFolderCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Style="{StaticResource Caption}" Margin="2,6,0,0"
                       Text="Settings saves to config.json as you edit. Comments (//) in the file are not kept." />

            <TextBlock Style="{StaticResource SectionTitle}" Text="About" />
            <ContentControl Style="{StaticResource SettingRow}" s:Setting.Icon="&#xE946;"
                            s:Setting.Title="{Binding Version, StringFormat='Folderite {0}'}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
