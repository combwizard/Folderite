<UserControl x:Class="Folderite.Settings.Pages.ActionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="2*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <!-- List -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="8">
                    <Button Style="{StaticResource ToolButton}" Content="&#xE710;" Tag="Add action"
                            ToolTip="Add an action" Command="{Binding AddActionCommand}" />
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE70E;" ToolTip="Move up"
                            Command="{Binding MoveActionUpCommand}" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE70D;" ToolTip="Move down"
                            Command="{Binding MoveActionDownCommand}" />
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE74D;" ToolTip="Remove"
                            Command="{Binding RemoveActionCommand}" />
                </WrapPanel>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="14,8,14,10"
                           Text="Actions appear in the submenu of the current folder at the top of the menu." />

                <Grid>
                    <ListBox x:Name="List" ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" Padding="4"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,4">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Command}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding Actions.Count, Converter={StaticResource ZeroToVisible}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE756;" FontSize="32" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextAlignment="Center"
                                   Text="No actions yet. Add one to run a program on the current folder." />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Details -->
        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <Grid>
                <TextBlock Style="{StaticResource Caption}" Text="Select an action to edit it."
                           Visibility="{Binding SelectedAction, Converter={StaticResource NullToVisible}}" />

                <StackPanel DataContext="{Binding SelectedAction}"
                            Visibility="{Binding Converter={StaticResource NotNullToVisible}}">
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,4" Text="Action" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Put &amp; before a letter to make it the shortcut key, &amp;&amp; for a plain &amp;." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Command" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="6,0,0,0"
                                Content="&#xE838;" ToolTip="Browse" Click="Browse_Click" />
                        <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Arguments" />
                    <TextBox Text="{Binding Args, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0">
                        <Run Text="{}{path}" FontWeight="SemiBold" /><Run Text=" is replaced by the current folder, e.g. " /><Run Text="-d &quot;{path}&quot;" FontFamily="Consolas" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
